{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hearing list",
  "type": "object",
  "required": [
    "appealsList",
    "businessList",
    "commercialCourt",
    "financialList",
    "insolvency&CompaniesCourt",
    "intellectualPropertyEnterpric",
    "intellectualPropertyList",
    "londonCircuitCommercialCourt",
    "patentsCourt",
    "property,TrustsAndProbate",
    "technologyAndConstructionCou",
    "admiraltyCourt",
    "companiesWindingUp",
    "competitionList",
    "pensionsList",
    "revenueList"
  ],
  "properties": {
    "appealsList": {
      "$ref": "#/$defs/hearingList"
    },
    "businessList": {
      "$ref": "#/$defs/hearingList"
    },
    "commercialCourt": {
      "$ref": "#/$defs/hearingList"
    },
    "financialList": {
      "$ref": "#/$defs/hearingList"
    },
    "insolvency&CompaniesCourt": {
      "$ref": "#/$defs/hearingList"
    },
    "intellectualPropertyEnterpric": {
      "$ref": "#/$defs/hearingList"
    },
    "intellectualPropertyList": {
      "$ref": "#/$defs/hearingList"
    },
    "londonCircuitCommercialCourt": {
      "$ref": "#/$defs/hearingList"
    },
    "patentsCourt": {
      "$ref": "#/$defs/hearingList"
    },
    "property,TrustsAndProbate": {
      "$ref": "#/$defs/hearingList"
    },
    "technologyAndConstructionCou": {
      "$ref": "#/$defs/hearingList"
    },
    "admiraltyCourt": {
      "$ref": "#/$defs/hearingList"
    },
    "companiesWindingUp": {
      "$ref": "#/$defs/hearingList"
    },
    "competitionList": {
      "$ref": "#/$defs/hearingList"
    },
    "pensionsList": {
      "$ref": "#/$defs/hearingList"
    },
    "revenueList": {
      "$ref": "#/$defs/hearingList"
    }
  },
  "$defs": {
    "hearingList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hearing"
      }
    },
    "hearing": {
      "type": "object",
      "properties": {
        "judgeName": {
          "title": "Judge name",
          "type": "string",
          "default": "",
          "examples": [
            "Judge name"
          ]
        },
        "timeOfHearing": {
          "title": "Time of hearing",
          "type": "string",
          "default": "",
          "examples": [
            "10:30am"
          ],
          "pattern": "^\\d{1,2}([:.]\\d{2})?[aApP][mM]\\s*$"
        },
        "venueName": {
          "title": "Venue name",
          "type": "string",
          "default": "",
          "examples": [
            "This is venue name"
          ]
        },
        "typeOfHearing": {
          "title": "Type of hearing",
          "type": "string",
          "default": "",
          "examples": [
            "This is hearing type"
          ]
        },
        "caseReferenceNumber": {
          "title": "Case reference number",
          "type": "string",
          "default": "",
          "examples": [
            "1234"
          ]
        },
        "caseName": {
          "title": "Case name",
          "type": "string",
          "default": "",
          "examples": [
            "This is case name"
          ]
        },
        "additionalInformation": {
          "title": "Additional information",
          "type": "string",
          "default": "",
          "examples": [
            "This is additional information"
          ]
        }
      }
    }
  }
}
