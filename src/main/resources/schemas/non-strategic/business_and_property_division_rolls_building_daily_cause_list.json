{
  "$defs": {
    "hearingList": {
      "type": "array",
      "items": {
        "title": "Hearing list",
        "type": "object",
        "required": [
          "judge",
          "time",
          "venue",
          "type",
          "caseNumber",
          "caseName",
          "additionalInformation"
        ],
        "properties": {
          "judge": {
            "title": "Judge name",
            "type": "string",
            "default": "",
            "examples": [
              "Judge name"
            ]
          },
          "time": {
            "title": "Time of hearing",
            "type": "string",
            "default": "",
            "examples": [
              "10:30am"
            ],
            "pattern": "^\\d{1,2}([:.]\\d{2})?[aApP][mM]\\s*$"
          },
          "venue": {
            "title": "Venue name",
            "type": "string",
            "default": "",
            "examples": [
              "This is venue name"
            ]
          },
          "type": {
            "title": "Type of hearing",
            "type": "string",
            "default": "",
            "examples": [
              "This is hearing type"
            ]
          },
          "caseNumber": {
            "title": "Case reference number",
            "type": "string",
            "default": "",
            "examples": [
              "1234"
            ]
          },
          "caseName": {
            "title": "Case name",
            "type": "string",
            "default": "",
            "examples": [
              "This is case name"
            ]
          },
          "additionalInformation": {
            "title": "Additional information",
            "type": "string",
            "default": "",
            "examples": [
              "This is additional information"
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Root",
  "type": "object",
  "required": [
    "appealList",
    "businessList",
    "commercialCourt",
    "financialList",
    "insolvency&CompaniesCourt",
    "ip&EnterpriseCourt",
    "intellectualPropertyList",
    "londonCircuitCommercialCourt",
    "patentsCourt",
    "property,Trusts&ProbateList",
    "technology&ConstructionCourt",
    "admiraltyCourt",
    "companiesWindingUp",
    "competitionList",
    "pensionsList",
    "revenueList"
  ],
  "properties": {
    "appealList": {
      "$ref": "#/$defs/hearingList"
    },
    "businessList": {
      "$ref": "#/$defs/hearingList"
    },
    "commercialCourt": {
      "$ref": "#/$defs/hearingList"
    },
    "financialList": {
      "$ref": "#/$defs/hearingList"
    },
    "insolvency&CompaniesCourt": {
